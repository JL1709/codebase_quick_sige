# The local prototype runs without environment variables.
# These values will activate the hosted Supabase repository adapter in the next deployment phase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional read-only, one-time contact import connectors. File import works without them.
# Local preview: Microsoft SPA redirect and Google JS origin are http://localhost:4173.
# Test/production must use their exact HTTPS origins; configure each environment separately.
# These are public browser client IDs, never client secrets. See docs/CONTACTS.md.
VITE_MICROSOFT_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
